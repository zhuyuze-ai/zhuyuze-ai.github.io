{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<!--
  MapMyVisitors visitor tracking. The whole block hides itself if the
  service is down or unreachable, so visitors never see a broken image.
-->
<div id="visitor-map" style="margin: 4rem auto 0; text-align: center; opacity: 0.75;">
  <a href="https://mapmyvisitors.com/web/1c757" title="Visit tracker" style="display: inline-block;">
    <img
      src="https://mapmyvisitors.com/map.png?d=4j1BSKSBzF_8E3NXRF3YkJPVGeturyf0opWNbRJu6qY&cl=ffffff&w=500"
      style="max-width: 100%; width: 420px; border-radius: 12px; border: 1px solid var(--global-divider-color);"
      alt="Visitor map"
      loading="lazy"
      onerror="document.getElementById('visitor-map').style.display='none'"
    >
  </a>
</div>

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
