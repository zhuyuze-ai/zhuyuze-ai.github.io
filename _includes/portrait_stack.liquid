{% comment %}
  Stacked portrait prints with prev/next arrows and position dots. Photos come
  from page.profile.portraits; the first one is the default (front) photo.
  Clicking opens the same lightbox the photography page uses (its styles live
  in _sass/_photography.scss), captioned "date, place" the same way.
{% endcomment %}
{% assign portraits = include.portraits %}
<aside class="portrait" aria-label="Profile photos">
  <div class="portrait-stage">
    <div class="portrait-stack" role="button" tabindex="0" aria-label="View photo larger">
      {% for p in portraits %}
        {% assign pos = forloop.index0 %}
        {% if pos > 3 %}{% assign pos = 3 %}{% endif %}
        {% assign caption = p.date | append: ', ' | append: p.place %}
        {% if p.title %}{% assign caption = p.title | append: ' · ' | append: caption %}{% endif %}
        <span
          class="portrait-print"
          data-position="{{ pos }}"
          data-photo="{{ forloop.index0 }}"
          {% unless forloop.first %}
            aria-hidden="true"
          {% endunless %}
        >
          <span class="portrait-window">
            <img
              src="{{ p.image | prepend: 'assets/img/' | relative_url | bust_file_cache }}"
              alt="{{ p.alt }}"
              data-caption="{{ caption }}"
              width="1200"
              height="1200"
              draggable="false"
              {% if forloop.first %}
                loading="eager"
              {% else %}
                loading="lazy"
              {% endif %}
            >
          </span>
        </span>
      {% endfor %}
    </div>
    {% if portraits.size > 1 %}
      <button class="portrait-arrow portrait-arrow--prev" type="button" aria-label="Previous portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m14 6-6 6 6 6"></path>
        </svg>
      </button>
      <button class="portrait-arrow portrait-arrow--next" type="button" aria-label="Next portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m10 6 6 6-6 6"></path>
        </svg>
      </button>
    {% endif %}
    <button class="portrait-expand" type="button" aria-label="View photo larger" title="View photo larger">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"></path>
      </svg>
    </button>
  </div>
  {% if portraits.size > 1 %}
    <div class="portrait-dots" aria-hidden="true">
      {% for p in portraits %}
        <span class="portrait-dot{% if forloop.first %} is-current{% endif %}"></span>
      {% endfor %}
    </div>
  {% endif %}

  <!-- Same markup as the photography page's lightbox; moved to <body> by the script. -->
  <div class="photo-lightbox portrait-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true">
    <button class="photo-lightbox-close" type="button" aria-label="Close viewer">&times;</button>
    <button class="photo-lightbox-nav photo-lightbox-prev" type="button" aria-label="Previous photo">&#8249;</button>
    <figure class="photo-lightbox-figure">
      <img class="photo-lightbox-img" alt="" draggable="false">
      <figcaption class="photo-lightbox-caption"></figcaption>
    </figure>
    <button class="photo-lightbox-nav photo-lightbox-next" type="button" aria-label="Next photo">&#8250;</button>
  </div>
</aside>
<script defer src="{{ '/assets/js/portrait-stack.js' | relative_url | bust_file_cache }}"></script>
