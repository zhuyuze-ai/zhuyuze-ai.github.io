{% comment %}
  Stacked portrait prints with prev/next arrows, position dots and an
  expandable viewer. Photos come from page.profile.portraits; the first one
  is the default (front) photo.
{% endcomment %}
{% assign portraits = include.portraits %}
<aside class="portrait" aria-label="Profile photos">
  <div class="portrait-stage">
    <div class="portrait-stack" role="button" tabindex="0" aria-label="Open portrait">
      {% for p in portraits %}
        {% assign pos = forloop.index0 %}
        {% if pos > 3 %}{% assign pos = 3 %}{% endif %}
        <span
          class="portrait-print"
          data-position="{{ pos }}"
          data-photo="{{ forloop.index0 }}"
          {% unless forloop.first %}
            aria-hidden="true"
          {% endunless %}
        >
          <span class="portrait-window">
            <img
              src="{{ p.image | prepend: 'assets/img/' | relative_url | bust_file_cache }}"
              alt="{{ p.alt }}"
              data-location="{{ p.location }}"
              width="1200"
              height="1200"
              draggable="false"
              {% if forloop.first %}
                loading="eager"
              {% else %}
                loading="lazy"
              {% endif %}
            >
          </span>
        </span>
      {% endfor %}
    </div>
    {% if portraits.size > 1 %}
      <button class="portrait-arrow portrait-arrow--prev" type="button" aria-label="Previous portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m14 6-6 6 6 6"></path>
        </svg>
      </button>
      <button class="portrait-arrow portrait-arrow--next" type="button" aria-label="Next portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m10 6 6 6-6 6"></path>
        </svg>
      </button>
    {% endif %}
    <button class="portrait-expand" type="button" aria-label="Expand photograph" title="Expand photograph">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"></path>
      </svg>
    </button>
  </div>
  {% if portraits.size > 1 %}
    <div class="portrait-dots" aria-hidden="true">
      {% for p in portraits %}
        <span class="portrait-dot{% if forloop.first %} is-current{% endif %}"></span>
      {% endfor %}
    </div>
  {% endif %}
  <dialog class="portrait-viewer" aria-label="Expanded portrait photograph">
    <div class="portrait-full-frame">
      <img class="portrait-full-image" alt="" draggable="false">
      <div class="portrait-full-meta">
        <strong>
          {{- site.first_name }}
          {{ site.last_name -}}
        </strong>
        {% if include.caption -%}
          <span>{{ include.caption }}</span>
        {%- endif %}
        <span class="portrait-full-location"></span>
      </div>
      {% if portraits.size > 1 %}
        <button class="portrait-viewer-arrow portrait-viewer-arrow--prev" type="button" aria-label="Previous portrait">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m14 6-6 6 6 6"></path>
          </svg>
        </button>
        <button class="portrait-viewer-arrow portrait-viewer-arrow--next" type="button" aria-label="Next portrait">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m10 6 6 6-6 6"></path>
          </svg>
        </button>
      {% endif %}
      <button class="portrait-close" type="button" aria-label="Close photograph" title="Close photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </dialog>
</aside>
<script defer src="{{ '/assets/js/portrait-stack.js' | relative_url | bust_file_cache }}"></script>
